# ================= MAJBURIY =================

# @BotFather → /newbot orqali olingan token
TELEGRAM_BOT_TOKEN=

# platform.claude.com → Settings → API keys
# Max tarifidagi $100 kredit ulangan tashkilotdan oling
ANTHROPIC_API_KEY=

# Botdan foydalana oladigan Telegram ID(lar), vergul bilan.
# Noto'g'ri bo'lsa, botga yozganingizda u sizga to'g'ri ID'ni aytadi.
OWNER_IDS=213370688

# ================= IXTIYORIY =================

# Standart model: auto | claude-opus-5-5 | claude-fable-5-1 | claude-sonnet-5-5 | claude-haiku-5-5
# auto — savol murakkabligiga qarab AUTO_MODELS dan tanlaydi (kreditni tejaydi)
DEFAULT_MODEL=claude-opus-5-5
AUTO_MODELS=claude-haiku-5-5,claude-sonnet-5-5,claude-opus-5-5

# Tez ishlar (tasniflash, qisqartirish, tarjima tugmalari) uchun arzon model
QUICK_MODEL=claude-haiku-5-5

# Model so'rovni rad etsa, javob beradigan zaxira model (o'chirish uchun: off)
FALLBACK_MODEL=claude-opus-4-8

# Bitta javob uchun eng ko'p token (fikrlash bilan birga)
MAX_TOKENS=32000

# Internet qidiruvi standart holatda (on/off). Botda /qidiruv bilan almashtiriladi
WEB_SEARCH=on
WEB_SEARCH_MAX_USES=5

# Kesh muddati: 5m (standart) yoki 1h — uzun tanaffuslar bilan suhbatlashsangiz foydali, lekin kesh yozish 2x qimmat
CACHE_TTL=5m

# Suhbatda xabarlar shundan ko'paysa, eng eski yarmi kontekstdan chiqariladi
HISTORY_MAX_MESSAGES=40

# Kontekst shu tokendan oshsa, javob ostida /new tavsiyasi chiqadi
LONG_CONTEXT_WARN_TOKENS=80000

# /xarajat uchun: oylik kredit ($) va u yangilanadigan kun (Max obunangiz to'lanadigan kun, 1–28)
MONTHLY_BUDGET=100
BUDGET_RESET_DAY=1
# Kredit shu foizga yetganda hamma ECONOMY_MODEL bilan ishlaydi (0 — o'chiq). 50/80/100% da egasiga xabar keladi
BUDGET_ECONOMY_PERCENT=90
ECONOMY_MODEL=claude-haiku-5-5

# Xabardagi havolalarni (maqola, PDF) o'qish (on/off) va bitta fayl uchun chegara (MB)
LINK_READING=on
LINK_MAX_MB=8

# Kunlik zaxira: bot.db nusxasi egasiga shu vaqtda yuboriladi (HH:MM, mahalliy vaqt) yoki off
BACKUP_TIME=03:30

TIMEZONE=Asia/Tashkent

# Sinov nusxasi uchun (install-test.sh o'zi yozadi): CONTAINER_NAME=claude-telegram-bot-test
