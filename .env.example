# ================= MAJBURIY =================

# @BotFather → /newbot orqali olingan token
TELEGRAM_BOT_TOKEN=

# platform.claude.com → Settings → API keys
# Max tarifidagi $100 kredit ulangan tashkilotdan oling
ANTHROPIC_API_KEY=

# Botdan foydalana oladigan Telegram ID(lar), vergul bilan.
# Noto'g'ri bo'lsa, botga yozganingizda u sizga to'g'ri ID'ni aytadi.
OWNER_IDS=213370688

# ================= IXTIYORIY =================

# Standart model: auto | claude-opus-5-5 | claude-fable-5-1 | claude-sonnet-5-5 | claude-haiku-5-5
# auto — savol murakkabligiga qarab AUTO_MODELS dan tanlaydi (kreditni tejaydi)
DEFAULT_MODEL=claude-opus-5-5
AUTO_MODELS=claude-haiku-5-5,claude-sonnet-5-5,claude-opus-5-5

# Tez ishlar (tasniflash, qisqartirish, tarjima tugmalari) uchun arzon model
QUICK_MODEL=claude-haiku-5-5

# Model so'rovni rad etsa, javob beradigan zaxira model (o'chirish uchun: off)
FALLBACK_MODEL=claude-opus-4-8

# Bitta javob uchun eng ko'p token (fikrlash bilan birga)
MAX_TOKENS=32000

# Internet qidiruvi standart holatda (on/off). Botda /qidiruv bilan almashtiriladi
WEB_SEARCH=on
WEB_SEARCH_MAX_USES=5
# Qidiruv joylashuvi: shahar va vaqt zonasi yuboriladi; mamlakat kodi (ISO, masalan US) faqat kerak bo'lsa —
# API ba'zi kodlarni (UZ ham) qabul qilmaydi, shuning uchun standartda bo'sh
SEARCH_CITY=Tashkent
SEARCH_COUNTRY=

# Kesh muddati: 5m (standart) yoki 1h — uzun tanaffuslar bilan suhbatlashsangiz foydali, lekin kesh yozish 2x qimmat
CACHE_TTL=5m

# Suhbatda xabarlar shundan ko'paysa, eng eski yarmi kontekstdan chiqariladi
HISTORY_MAX_MESSAGES=40

# Kontekst shu tokendan oshsa, javob ostida /new tavsiyasi chiqadi
LONG_CONTEXT_WARN_TOKENS=80000

# /xarajat uchun: oylik kredit ($) va u yangilanadigan kun (Max obunangiz to'lanadigan kun, 1–28)
MONTHLY_BUDGET=100
BUDGET_RESET_DAY=1
# Kredit shu foizga yetganda hamma ECONOMY_MODEL bilan ishlaydi (0 — o'chiq). 50/80/100% da egasiga xabar keladi
BUDGET_ECONOMY_PERCENT=90
ECONOMY_MODEL=claude-haiku-5-5

# Xabardagi havolalarni (maqola, PDF) o'qish (on/off) va bitta fayl uchun chegara (MB)
LINK_READING=on
LINK_MAX_MB=8

# Avtomatik zaxira: bot.db nusxasi egasiga shu kuni va vaqtda yuboriladi.
# BACKUP_DAY — hafta kuni (dushanba … yakshanba yoki 1–7) yoki «har kuni»; BACKUP_TIME — HH:MM (mahalliy vaqt) yoki off
BACKUP_DAY=dushanba
BACKUP_TIME=03:30

# Call center hisoboti: operatorlarning lid ostidagi izohlarini tahlil qiluvchi model (arzon model yetarli).
# Telefon raqamlar modelga yuborilmaydi. Qolgan sozlamalar (operatorlar, guruhlar, vaqt) — Mini App → Hisobotlar
REPORT_MODEL=claude-haiku-5-5
# Rahbarlar botga yozib hisobot so'raydi (AI javob beradi, telefonlar yashirilgan): har rahbarga kunlik savollar
# chegarasi (0 — cheklanmagan). Xarajat /xarajat da «👔 rahbar» qatorida ko'rinadi.
LEADER_DAILY_LIMIT=30

# Yangilanishdan keyin yangi versiya shuncha soniya muammosiz ishlasa — muvaffaqiyatli deb belgilanadi; shu vaqt
# ichida yiqilsa, eski versiya avtomatik tiklanadi. Odatda o'zgartirilmaydi.
UPDATE_PROBATION=30

# Mini App (Telegram ichidagi ilova): botning HTTPS manzili. Bo'sh — ilova o'chiq.
# Masalan: WEBAPP_URL=https://bepulkurs.uz/yordamchi/   (README → Mini App: Caddy sozlamasi)
WEBAPP_URL=
# Konteyner ichidagi port; docker-compose uni faqat 127.0.0.1 ga ochadi (sinov botida 8092)
WEBAPP_PORT=8091
# Mini App galereyasi uchun saqlanadigan yaratilgan fayllar hajmi (har foydalanuvchi, MB)
FILES_MAX_MB=300

# GitHub'dan yangilash (/yangilash github): repo owner/repo ko'rinishida; o'chirish uchun: off
GITHUB_REPO=Qibraysadosi/tta-yordamchi-bot
# Faqat yopiq (private) repo uchun, ochiq repo tokensiz ishlaydi. github.com → Settings →
# Developer settings → Personal access tokens → Fine-grained tokens: faqat shu repo, Contents: Read-only
GITHUB_TOKEN=
# Release bo'lmasa shu tarmoq arxivi o'rnatiladi (versiya undagi VERSION faylidan)
GITHUB_BRANCH=main
# Har kuni zaxira vaqtida (BACKUP_TIME, zaxira o'chiq bo'lsa 03:30) yangi versiyani tekshirib,
# bo'lsa egasiga bir marta xabar (on/off)
UPDATE_CHECK=on

TIMEZONE=Asia/Tashkent

# Sinov nusxasi uchun (install-test.sh o'zi yozadi): CONTAINER_NAME=claude-telegram-bot-test
